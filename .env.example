# Copy to .env.local. Public publishable/anon key only. Never add a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Demo is isolated browser data. Set false to hide it on a production deployment.
NEXT_PUBLIC_ENABLE_DEMO=true
# With no Supabase configuration, persistent local accounts are enabled on this
# computer (disabled on Vercel). Set false to allow only the fictional demo.
AFTERBELL_LOCAL_ACCOUNTS=true
